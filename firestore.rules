rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // A signed-in account only counts as staff if an admin created its users/{uid} profile.
    // (Self-service sign-up creates an Auth account but never this profile, so it gets no data.)
    function isStaff() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Approving is an admin decision: only admins may set Approved / Paid on quotations and vouchers.
    function approvalSafeCreate() {
      return isAdmin() || !(request.resource.data.get('status', 'Pending') in ['Approved', 'Paid']);
    }
    function approvalSafeUpdate() {
      return isAdmin()
             || request.resource.data.get('status', null) == resource.data.get('status', null)
             || !(request.resource.data.get('status', null) in ['Approved', 'Paid']);
    }

    // ── Users collection ──────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Only an admin creates profiles — nobody can self-promote by writing their own users/{uid}.
      allow create: if isAdmin()
                       && request.resource.data.keys().hasAll(['uid', 'email', 'username', 'role'])
                       && request.resource.data.role in ['admin', 'user'];
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin())
                       && request.resource.data.role in ['admin', 'user']
                       // Non-admins may edit their own profile but never their
                       // role, identity or login fields (prevents self-promotion).
                       && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys()
                                          .hasAny(['role', 'uid', 'email', 'username']));
      allow delete: if isAdmin();
    }

    // ── Username → email index (used by login before sign-in) ─
    // Doc ID = lowercased username, data = { uid, email }.
    // Single-document get is public; listing/enumeration is denied.
    match /usernames/{name} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isAuthenticated()
                       && name == name.lower()
                       && request.resource.data.keys().hasOnly(['uid', 'email'])
                       && (isAdmin() || (request.resource.data.uid == request.auth.uid
                                         && isStaff()
                                         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '') == name));
      allow update: if isAuthenticated()
                       && request.resource.data.keys().hasOnly(['uid', 'email'])
                       && (isAdmin() || (resource.data.uid == request.auth.uid
                                         && request.resource.data.uid == request.auth.uid));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // ── Financial Categories ──────────────────────────────────
    match /fin_categories/{catId} {
      allow read:   if isStaff();
      allow create: if isAdmin()
                       && request.resource.data.keys().hasAll(['code', 'name', 'type', 'budget'])
                       && request.resource.data.type   in [1, 2]
                       && request.resource.data.budget is number
                       && request.resource.data.budget >= 0;
      allow update: if isAdmin()
                       && request.resource.data.type   in [1, 2]
                       && request.resource.data.budget is number
                       && request.resource.data.budget >= 0;
      allow delete: if isAdmin();
    }

    // ── Financial Transactions ────────────────────────────────
    match /fin_transactions/{txnId} {
      allow read: if isStaff();

      allow create: if isStaff()
                       && request.resource.data.keys().hasAll(['date', 'catCode', 'desc', 'amount', 'payment_status'])
                       && request.resource.data.amount         is number
                       && request.resource.data.amount         >  0
                       && request.resource.data.payment_status is int
                       && request.resource.data.payment_status in [0, 1, 2]
                       // Staff may only file pending (1) entries; "paid"/"rejected" is an admin decision.
                       && (isAdmin() || request.resource.data.payment_status == 1)
                       && request.resource.data.desc.size()    >  0
                       && request.resource.data.desc.size()    <= 500;

      allow update: if isStaff()
                       && request.resource.data.amount         is number
                       && request.resource.data.amount         >  0
                       && request.resource.data.payment_status is int
                       && request.resource.data.payment_status in [0, 1, 2]
                       && (
                            isAdmin()
                            // Staff may only edit entries that are still pending, and cannot change the status.
                            || (resource.data.payment_status == 1 && request.resource.data.payment_status == 1)
                          );

      allow delete: if isAdmin();
    }

    // ── Quotations, Invoices & Receipts ───────────────────────
    match /quotations/{docId} {
      allow read:   if isStaff();
      allow create: if isStaff() && approvalSafeCreate();
      allow update: if isStaff() && approvalSafeUpdate();
      allow delete: if isAdmin();
    }

    match /invoices/{docId} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /receipts/{docId} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /certificates/{docId} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /vouchers/{docId} {
      allow read:   if isStaff();
      allow create: if isStaff() && approvalSafeCreate();
      allow update: if isStaff() && approvalSafeUpdate();
      allow delete: if isAdmin();
    }

    match /letters/{docId} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Calendar Events ───────────────────────────────────────
    // Events/tasks: anyone signed in can read and create (as themselves).
    // Creator, assignees and admins can edit; only creator or admin can delete.
    // Older events with no createdBy stay editable by everyone, deletable by admin.
    match /calendar_events/{evtId} {
      function ownerOf(data)   { return data.get('createdBy', null); }
      function isCreator()     { return ownerOf(resource.data) == request.auth.uid; }
      function isAssignee()    { return request.auth.uid in resource.data.get('assignees', []); }
      function isLegacy()      { return ownerOf(resource.data) == null; }

      allow read:   if isStaff();
      allow create: if isStaff()
                       && request.resource.data.createdBy == request.auth.uid
                       && request.resource.data.get('assignees', []) is list
                       && request.resource.data.get('status', 'todo') in ['todo', 'doing', 'done'];
      allow update: if isStaff()
                       && (isAdmin() || isCreator() || isAssignee() || isLegacy())
                       && ownerOf(request.resource.data) == ownerOf(resource.data)
                       && request.resource.data.get('assignees', []) is list
                       && request.resource.data.get('status', 'todo') in ['todo', 'doing', 'done'];
      allow delete: if isStaff() && (isAdmin() || isCreator());
    }

    // Name-only staff list for picking assignees (no bank/phone data).
    match /staff_directory/{uid} {
      allow read:  if isStaff();
      allow write: if isStaff() && (request.auth.uid == uid || isAdmin())
                      && (request.resource == null
                          || request.resource.data.keys().hasOnly(['uid', 'name']));
    }

    // ── Contracts (contain ID numbers, salaries, bank details) ──
    match /contracts/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Team: attendance, leave, equipment, announcements ─────
    // attendance doc ID = {uid}_{yyyy-mm-dd}
    match /attendance/{id} {
      allow read:   if isStaff();
      allow create: if isStaff()
                       && request.resource.data.uid == request.auth.uid
                       && id == request.auth.uid + '_' + request.resource.data.date
                       && request.resource.data.createdAt == request.time;     // server-stamped
      allow update: if isStaff()
                       && request.resource.data.uid == resource.data.uid
                       && (isAdmin()
                           // Staff can only set their own check-out afterwards; check-in can't be rewritten.
                           || (resource.data.uid == request.auth.uid
                               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOut', 'updatedAt'])));
      allow delete: if isAdmin();
    }

    match /leave_requests/{id} {
      allow read:   if isStaff() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isStaff()
                       && request.resource.data.uid == request.auth.uid
                       && request.resource.data.status == 'pending'
                       && request.resource.data.type in ['sick', 'vacation', 'personal', 'other']
                       && request.resource.data.days is number
                       && request.resource.data.days >= 1 && request.resource.data.days <= 365
                       && request.resource.data.startDate is string && request.resource.data.endDate is string;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isStaff() && resource.data.uid == request.auth.uid
                                     && resource.data.status == 'pending');
    }

    match /equipment/{id} {
      allow read:   if isStaff();
      allow create, delete: if isAdmin();
      // Anyone may borrow / return; only the borrow fields may change.
      allow update: if isAdmin() ||
                       (isStaff() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'holderUid', 'holderName', 'borrowedAt', 'dueDate']) &&
                        (
                          // borrow: item is free and you become the holder
                          (resource.data.status == 'available' && request.resource.data.status == 'borrowed'
                           && request.resource.data.holderUid == request.auth.uid)
                          // return: only the current holder
                          || (resource.data.status == 'borrowed' && resource.data.holderUid == request.auth.uid
                              && request.resource.data.status == 'available')
                        ));
    }

    match /equipment_log/{id} {
      allow read:   if isStaff();
      allow create: if isStaff() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /announcements/{id} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // Read-only from the app; the company identity now lives in assets/js/bo/pages/company-info.js.
    match /company_profile/{id} {
      allow read:  if isStaff();
      allow write: if false;
    }
  }
}
